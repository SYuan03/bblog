          "source_id": "paper",
          "locator": "§3.5 Eq4–6"
        }
      ],
      "article_quote": "原始奖励还要减去其他样本均值，称为 LOO（leave-one-out）基线。"
    },
    {
      "term": "CISPO",
      "kind": "loss",
      "source_ids": [
        "paper"
      ],
      "source_locators": [
        {
          "source_id": "paper",
          "locator": "§3.5 Eq7–8"
        }
      ],
      "article_quote": "CISPO 用当前与采样时输出概率的比值加权并截断，更新被选中文字"
    },
    {
      "term": "N=1",
      "kind": "operation",
      "source_ids": [
        "paper"
      ],
      "source_locators": [
        {
          "source_id": "paper",
          "locator": "§4.3;Evaluation/evaluation_common.py"
        }
      ],
      "article_quote": "普通评测每题只跑一棵递归树（N=1），不写 rubric、不选候选。"
    },
    {
      "term": "Disc",
      "kind": "loss",
      "source_ids": [
        "paper"
      ],
      "source_locators": [
