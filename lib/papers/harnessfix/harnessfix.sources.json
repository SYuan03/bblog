      ],
      "evidence": [
        {
          "artifact": "article",
          "quote": "公开材料仍不足以逐条重建 57,780→26,174 的筛选链。"
        },
        {
          "artifact": "article",
          "quote": "LLM-assisted taxonomy 也可能把作者自己的修复语言写回 gold。"
        }
      ]
