<%
  const cats = page.categories ? page.categories.toArray() : [];
  const tags = page.tags ? page.tags.toArray() : [];
  const tocHtml = toc(page.content, { list_number: false, min_depth: 2, max_depth: 3 });
  const hasToc = tocHtml && strip_html(tocHtml).trim().length > 0;
  const isEncrypted = String(page.content || '').includes('hexo-blog-encrypt');
  const commentsEnabled = theme.comments && theme.comments.enable && !isEncrypted;
  const deckText = post_summary(page, 150);
  const cover = post_cover(page);
  const coverSrcset = post_cover_srcset(page);
  const coverTone = post_cover_tone(page);
  const pageTagNames = new Set(tags.map((tag) => tag.name));
  const pageCategoryNames = new Set(cats.map((category) => category.name));
  const allPublicPosts = site.posts ? site.posts.toArray().filter((post) => post.path !== page.path && !String(post.content || '').includes('hexo-blog-encrypt')) : [];
  const scoredRelated = allPublicPosts.map((post) => {
    const postTags = post.tags ? post.tags.toArray() : [];
    const postCategories = post.categories ? post.categories.toArray() : [];
    const score = postTags.reduce((total, tag) => total + (pageTagNames.has(tag.name) ? 2 : 0), 0)
      + postCategories.reduce((total, category) => total + (pageCategoryNames.has(category.name) ? 3 : 0), 0);
    return { post, score };
  }).filter((item) => item.score > 0).sort((a, b) => b.score - a.score || b.post.date.valueOf() - a.post.date.valueOf());
  const relatedPosts = [...scoredRelated.map((item) => item.post), ...allPublicPosts]
    .filter((post, index, list) => list.findIndex((candidate) => candidate.path === post.path) === index)
    .slice(0, 3);
%>
<article class="article-shell section-shell">
  <header class="article-header reveal">
    <div class="article-kicker">
      <% if (cats.length) { %><a href="<%= url_for(cats[0].path) %>"><%= cats[0].name %></a><span>·</span><% } %>
      <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY.MM.DD') %></time>
    </div>
    <h1><%= page.title %></h1>
    <div class="article-deck">
      <p><%= deckText %></p>
      <dl class="article-stats">
        <div><dt>字数</dt><dd><%= wordcount(page) %></dd></div>
        <div><dt>阅读</dt><dd>约 <%= reading_minutes(page) %> 分钟</dd></div>
        <div><dt>更新</dt><dd><%= date(page.updated || page.date, 'YYYY.MM.DD') %></dd></div>
      </dl>
    </div>
    <div class="article-cover cover-tone-<%= coverTone %>">
      <span class="cover-art" aria-hidden="true"><i></i><i></i><i></i></span>
      <% if (cover) { %><img src="<%= url_for(cover) %>"<% if (coverSrcset) { %> srcset="<%= coverSrcset.split(', ').map((candidate) => { const [url, size] = candidate.split(' '); return `${url_for(url)} ${size}`; }).join(', ') %>" sizes="(max-width: 680px) calc(100vw - 28px), (max-width: 960px) min(760px, calc(100vw - 34px)), 860px"<% } %> alt="<%= page.title %>的文章首图" decoding="async" fetchpriority="high" data-cover-image><% } %>
    </div>
  </header>

  <div class="article-grid">
    <aside class="article-rail reveal">
      <div class="rail-sticky">
        <% if (hasToc) { %><span class="rail-label">目录</span><nav class="article-toc"><%- tocHtml %></nav><% } %>
        <div class="article-tools">
          <button type="button" data-focus-toggle aria-pressed="false"><span aria-hidden="true">◐</span> <span data-focus-label>专注模式</span></button>
          <button type="button" data-share><span>↗</span> 分享</button>
          <% if (commentsEnabled) { %><a href="#comments"><span>◇</span> 评论</a><% } %>
        </div>
      </div>
    </aside>

    <div class="article-main reveal">
      <div class="prose article-content markdown-body">
        <%- page.content %>
      </div>

      <% if (tags.length) { %>
        <div class="article-tags">
          <span>标签</span>
          <% tags.forEach((tag) => { %><a href="<%= url_for(tag.path) %>">#<%= tag.name %></a><% }) %>
        </div>
      <% } %>

      <% if (!isEncrypted && relatedPosts.length) { %>
        <section class="related-posts" aria-labelledby="related-title">
          <header>
            <div><h2 id="related-title">再读几篇</h2></div>
            <a href="<%= url_for('/archives/') %>">全部文章</a>
          </header>
          <div class="related-grid">
            <% relatedPosts.forEach((post) => { %>
              <a href="<%= url_for(post.path) %>" class="related-card">
                <span><%= date(post.date, 'YYYY.MM.DD') %></span>
                <strong><%= post.title %></strong>
              </a>
            <% }) %>
          </div>
        </section>
      <% } %>

      <nav class="post-navigation" aria-label="相邻文章">
        <% if (page.prev) { %>
          <a href="<%= url_for(page.prev.path) %>"><span>上一篇</span><strong><%= page.prev.title %></strong></a>
        <% } else { %><span></span><% } %>
        <% if (page.next) { %>
          <a class="next" href="<%= url_for(page.next.path) %>"><span>下一篇</span><strong><%= page.next.title %></strong></a>
        <% } %>
      </nav>

      <% if (commentsEnabled) { %>
        <section class="comments" id="comments" data-comments data-env-id="<%= theme.comments.env_id %>" data-comments-path="<%= comment_path(page) %>" data-comments-script="<%= url_for('/vendor/twikoo.min.js') %>">
          <div class="comments-heading">
            <div><h2>留言</h2></div>
          </div>
          <div id="twikoo-comment" aria-busy="true">
            <div class="comment-loading" role="status" aria-live="polite">留言正在载入…</div>
          </div>
        </section>
      <% } %>
    </div>
  </div>
</article>

<button class="focus-exit" type="button" data-focus-toggle data-focus-exit aria-pressed="false">
  <span aria-hidden="true">◑</span>
  <span data-focus-label>退出专注</span>
</button>
