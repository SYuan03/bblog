<%
  const latest = site.posts && site.posts.length ? site.posts.first() : null;
  const posts = page.posts ? page.posts.toArray() : [];
%>
<section class="home-hero section-shell">
  <div class="hero-copy reveal">
    <span class="eyebrow"><%= theme.hero.eyebrow %></span>
    <h1><%= theme.hero.title %></h1>
    <p><%= theme.hero.description %></p>
    <div class="hero-actions">
      <% if (latest) { %><a class="button button-primary" href="<%= url_for(latest.path) %>">读最新文章 <span>↗</span></a><% } %>
      <button class="button button-quiet" type="button" data-search-open>搜索笔记 <span>/</span></button>
    </div>
    <div class="hero-stats" aria-label="博客统计">
      <div><strong><%= site.posts.length %></strong><span>篇文章</span></div>
      <div><strong><%= site.categories.length %></strong><span>个分类</span></div>
      <div><strong>2023</strong><span>开始记录</span></div>
    </div>
  </div>

  <div class="hero-art reveal" aria-label="一幅宁静的风景插画">
    <div class="art-frame">
      <img class="hero-image hero-image-light" src="<%= url_for('/MyImgs/home-bg-light.webp') %>" alt="山野、云层与行旅者">
      <img class="hero-image hero-image-dark" src="<%= url_for('/MyImgs/home-bg-dark.webp') %>" alt="夜色山野">
      <div class="art-caption"><span>FIELD NOTE</span><b>03—11</b></div>
    </div>
    <span class="orbit orbit-one"></span>
    <span class="orbit orbit-two"></span>
  </div>

</section>

<section class="post-feed section-shell" id="notes">
  <header class="section-heading reveal">
    <div>
      <span class="eyebrow">LATEST NOTES</span>
      <h2>最新文章</h2>
    </div>
    <p>按时间排列的技术与生活记录。</p>
  </header>
  <div class="post-list">
    <% posts.forEach((post, index) => { %>
      <%- partial('_partial/post-card', { post, index }) %>
    <% }) %>
  </div>
  <% if (page.total > 1) { %>
    <nav class="pagination reveal" aria-label="文章分页">
      <% if (page.prev_link) { %><a href="<%= url_for(page.prev_link) %>">← 更新的</a><% } else { %><span></span><% } %>
      <span><%= page.current %> / <%= page.total %></span>
      <% if (page.next_link) { %><a href="<%= url_for(page.next_link) %>">更早的 →</a><% } %>
    </nav>
  <% } %>
</section>
