<%
  const posts = page.posts ? page.posts.toArray() : [];
  const publicPosts = site.posts ? site.posts.toArray().filter((post) => !String(post.content || '').includes('hexo-blog-encrypt')) : [];
  const extras = theme.home_extras || {};
  const profile = theme.profile || {};
  const artworks = extras.artworks || [];
  const artworkIndex = artworks.length ? Math.floor((Date.now() + 8 * 60 * 60 * 1000) / 86400000) % artworks.length : 0;
  const artwork = artworks[artworkIndex] || {};
  const categories = site.categories ? site.categories.toArray() : [];
  const featuredCategories = (theme.featured_categories || [])
    .map((name) => categories.find((category) => category.name === name))
    .filter(Boolean);
%>
<section class="post-feed home-feed section-shell" id="notes">
  <% if ((page.current || 1) > 1) { %>
    <h1 class="sr-only">文章列表，第 <%= page.current %> 页</h1>
  <% } %>
  <% if ((page.current || 1) === 1) { %>
    <header class="home-intro reveal">
      <div class="home-intro-copy">
        <h1><%= theme.hero.title %></h1>
        <p class="home-description"><%= theme.hero.description %></p>
      </div>

      <blockquote class="home-motto">
        <% (profile.motto || []).forEach((line) => { %><span><%= line %></span><% }) %>
      </blockquote>

      <% if (profile.wechat) { %>
        <div class="home-contact">
          <button class="profile-contact" type="button" data-copy-wechat data-copy-value="<%= profile.wechat %>" aria-label="复制微信号 <%= profile.wechat %>">
            <span>微信</span>
            <strong><%= profile.wechat %></strong>
            <small data-copy-label>复制</small>
          </button>
        </div>
      <% } %>

      <%- partial('_partial/profile-portrait', { profile }) %>
    </header>

    <% if (featuredCategories.length) { %>
      <nav class="home-topics reveal" aria-label="常写主题">
        <span>常写</span>
        <% featuredCategories.forEach((category) => { %>
          <a href="<%= url_for(category.path) %>"><%= category.name %><sup><%= category.length %></sup></a>
        <% }) %>
        <a class="home-topics-all" href="<%= url_for('/categories/') %>">全部分类</a>
      </nav>
    <% } %>

    <% if (artworks.length) { %>
      <aside class="today-strip reveal" data-today-strip data-quote-api="<%= extras.quote_api || '' %>" data-art-start-index="<%= artworkIndex %>">
        <div class="today-toolbar">
          <h2 id="today-heading">馆藏一隅</h2>
          <div class="today-actions">
            <span class="sr-only" data-today-status aria-live="polite"></span>
            <button class="today-refresh" type="button" data-today-refresh aria-label="换一幅画和一句话" title="换一幅画和一句话">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 7v5h-5"></path><path d="M4 17v-5h5"></path><path d="M6.1 8.2A7 7 0 0 1 18.7 6L20 8"></path><path d="M17.9 15.8A7 7 0 0 1 5.3 18L4 16"></path></svg>
            </button>
            <button class="today-toggle" type="button" data-today-toggle aria-expanded="true" aria-controls="today-panel" aria-label="收起馆藏" title="收起馆藏">
              <span data-today-toggle-label>收起</span>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 14 5-5 5 5"></path></svg>
            </button>
          </div>
        </div>

        <div class="today-panel" id="today-panel" role="region" aria-labelledby="today-heading" data-today-panel>
          <div class="today-panel-inner">
            <figure class="today-figure">
              <a class="today-art" href="<%= artwork.object_url %>" target="_blank" rel="noopener" data-art-link aria-label="查看《<%= artwork.title_zh || artwork.title %>》的馆藏详情">
                <img src="<%= url_for(artwork.image) %>" alt="<%= artwork.title_zh || artwork.title %>，<%= artwork.artist_zh || artwork.artist %>" width="960" height="720" loading="lazy" decoding="async" fetchpriority="low" data-art-image>
              </a>
            </figure>

            <div class="today-copy">
              <div class="today-work">
                <p class="today-facts">
                  <span data-art-origin><%= artwork.origin %></span>
                  <span data-art-date><%= artwork.date %></span>
                  <span data-art-medium><%= artwork.medium %></span>
                </p>
                <h3><a href="<%= artwork.object_url %>" target="_blank" rel="noopener" data-art-title-link><span data-art-title-zh><%= artwork.title_zh || artwork.title %></span></a></h3>
                <% if (artwork.title_zh && artwork.title) { %><p class="today-art-title" lang="en" data-art-title><%= artwork.title %></p><% } else { %><p class="today-art-title" lang="en" data-art-title hidden></p><% } %>
                <p class="today-art-maker" data-art-maker><%= [artwork.artist_zh, artwork.artist].filter(Boolean).join(' · ') %></p>
                <a class="today-detail" href="<%= artwork.object_url %>" target="_blank" rel="noopener" data-art-detail>在 The Met 查看作品 <span>↗</span></a>
              </div>

              <div class="today-quote">
                <blockquote data-quote-text>“<%= extras.fallback_quote || '纸上得来终觉浅，绝知此事要躬行。' %>”</blockquote>
                <cite data-quote-citation><span data-quote-source><%= extras.fallback_source || '陆游' %></span></cite>
              </div>
            </div>
          </div>
        </div>

        <script type="application/json" data-artworks-json><%- JSON.stringify(artworks).replace(/</g, '\\u003c') %></script>
      </aside>
    <% } %>
  <% } %>

  <div class="feed-bar">
    <h2>最近写的</h2>
    <button class="text-action" type="button" data-random-post>随便翻翻</button>
  </div>
  <div class="resume-row" data-reading-history hidden>
    <span>接着读</span>
    <a href="/" data-history-last></a>
    <button class="resume-clear" type="button" data-history-clear aria-label="清除阅读记录" title="清除阅读记录">×</button>
  </div>
  <div class="post-list">
    <% posts.forEach((post) => { %>
      <%- partial('_partial/post-card', { post }) %>
    <% }) %>
  </div>
  <script>
    (() => {
      try {
        const row = document.querySelector('[data-reading-history]');
        const link = row?.querySelector('[data-history-last]');
        const current = JSON.parse(localStorage.getItem('tide-last-read-v1') || 'null');
        const legacy = JSON.parse(localStorage.getItem('tide-reading-history-v1') || '[]');
        const entry = current?.url ? current : (Array.isArray(legacy) ? legacy[0] : null);
        if (!row || !link || !entry?.url || !entry?.title) return;
        const target = new URL(entry.url, location.origin);
        if (target.origin !== location.origin) return;
        const href = `${target.pathname}${target.search}${target.hash}`;
        const visible = [...document.querySelectorAll('.post-card h2 a')].some((item) => {
          const candidate = new URL(item.href, location.origin);
          return `${candidate.pathname}${candidate.search}${candidate.hash}` === href;
        });
        if (visible) return;
        link.href = href;
        link.textContent = entry.title;
        row.hidden = false;
      } catch {
        // Reading history is optional and storage may be unavailable.
      }
    })();
  </script>
  <% if (page.total > 1) { %>
    <nav class="pagination reveal" aria-label="文章分页">
      <% if (page.prev_link) { %><a href="<%= url_for(page.prev_link) %>">← 更新的</a><% } else { %><span></span><% } %>
      <span><%= page.current %> / <%= page.total %></span>
      <% if (page.next_link) { %><a href="<%= url_for(page.next_link) %>">更早的 →</a><% } %>
    </nav>
  <% } %>
  <div class="random-post-sources" hidden>
    <% publicPosts.forEach((post) => { %><a href="<%= url_for(post.path) %>"></a><% }) %>
  </div>
</section>
