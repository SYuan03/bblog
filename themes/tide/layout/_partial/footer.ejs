<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <a class="footer-home" href="<%= url_for('/') %>"><%= config.title %></a>
    </div>
    <div class="footer-links">
      <a href="<%= theme.social.github %>" target="_blank" rel="noopener">GitHub ↗</a>
      <a href="<%= theme.social.email %>">邮箱 ↗</a>
      <a href="<%= url_for('/atom.xml') %>">RSS ↗</a>
    </div>
    <p class="footer-meta">© <%= theme.footer.since %>—<%= date(new Date(), 'YYYY') %> <%= config.author %></p>
  </div>
</footer>
