<footer class="site-footer">
  <div class="footer-inner">
    <div>
      <span class="footer-mark"><%= theme.identity.mark %></span>
      <p><%= theme.footer.note %></p>
    </div>
    <div class="footer-links">
      <a href="<%= theme.social.github %>" target="_blank" rel="noopener">GitHub ↗</a>
      <a href="<%= theme.social.email %>">Email ↗</a>
      <a href="<%= url_for('/atom.xml') %>">RSS ↗</a>
    </div>
    <p class="footer-meta">© <%= theme.footer.since %>—<%= date(new Date(), 'YYYY') %> <%= config.author %><br>自制主题 Tide · Powered by Hexo</p>
  </div>
</footer>
