<%
  const path = `/${page.path || ''}`;
  const activeFor = (itemPath) => itemPath === '/' ? is_home() : path.startsWith(itemPath);
%>
<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand" href="<%= url_for('/') %>" aria-label="<%= theme.brand || config.author %>，返回首页">
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 28 20" focusable="false">
          <circle class="brand-mark-sun" cx="22.8" cy="3.6" r="1.55"></circle>
          <path class="brand-mark-wave" d="M2 8.5c2.8-2.7 5.55-2.7 8.35 0s5.55 2.7 8.35 0 5.55-2.7 8.35 0"></path>
          <path class="brand-mark-wave brand-mark-wave-secondary" d="M4.4 13.7c2.3-1.85 4.6-1.85 6.9 0s4.6 1.85 6.9 0 4.6-1.85 6.9 0"></path>
        </svg>
      </span>
      <span class="brand-copy">
        <strong><%= theme.brand || config.author %></strong>
      </span>
    </a>

    <button class="nav-toggle" type="button" data-nav-toggle aria-expanded="false" aria-controls="site-nav">
      <span></span><span></span>
      <span class="sr-only">打开导航</span>
    </button>

    <nav class="site-nav" id="site-nav" data-nav>
      <% theme.navigation.forEach((item) => { %>
        <a href="<%= url_for(item.path) %>" class="<%= activeFor(item.path) ? 'is-active' : '' %>"<% if (activeFor(item.path)) { %> aria-current="page"<% } %>><%= item.label %></a>
      <% }) %>
    </nav>

    <div class="header-actions">
      <button class="icon-button search-trigger" type="button" data-search-open aria-label="搜索文章" aria-keyshortcuts="/">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4.2 4.2"></path></svg>
      </button>
      <button class="icon-button theme-toggle" type="button" data-theme-toggle aria-label="切换深浅色">
        <svg class="sun-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg>
        <svg class="moon-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.2 15.4A8.5 8.5 0 0 1 8.6 3.8 8.5 8.5 0 1 0 20.2 15.4Z"></path></svg>
      </button>
    </div>
  </div>
</header>
