<%
  const entries = Array.isArray(page.entries)
    ? page.entries.filter((entry) => entry && entry.datetime && entry.text)
    : [];
%>
<section class="now-page section-shell">
  <header class="now-header reveal">
    <h1><%= page.title %></h1>
  </header>

  <div class="now-log reveal">
    <% entries.forEach((entry) => { %>
      <article class="now-entry">
        <time datetime="<%= entry.datetime %>">
          <span><%= entry.date %></span>
          <b><%= entry.time %></b>
        </time>

        <div class="now-entry-content<%= entry.image ? ' has-image' : '' %>">
          <p><%= entry.text %></p>

          <% if (entry.image) { %>
            <figure class="now-entry-image">
              <% if (entry.image_source) { %><a href="<%= entry.image_source %>" target="_blank" rel="noopener noreferrer"><% } %>
                <img
                  src="<%= url_for(entry.image) %>"
                  alt="<%= entry.image_alt || '' %>"
                  width="<%= entry.image_width || 480 %>"
                  height="<%= entry.image_height || 600 %>"
                  loading="lazy"
                  decoding="async">
              <% if (entry.image_source) { %></a><% } %>
              <figcaption>
                <span><%= entry.image_caption || '' %></span>
                <% if (entry.image_credit) { %>
                  <a href="<%= entry.image_source %>" target="_blank" rel="noopener noreferrer"><%= entry.image_credit %></a><% if (entry.image_license && entry.image_license_url) { %>
                  · <a href="<%= entry.image_license_url %>" target="_blank" rel="license noopener noreferrer"><%= entry.image_license %></a><% } %>
                <% } %>
              </figcaption>
            </figure>
          <% } %>
        </div>
      </article>
    <% }) %>
  </div>
</section>
